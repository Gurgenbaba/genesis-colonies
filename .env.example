# Genesis Colonies — environment template (authorized development only)
# Proprietary software — see LICENSE. Not for public self-hosting.
# Copy:  copy .env.example .env   (Windows)
#        cp .env.example .env     (Linux/macOS)
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=1

# REQUIRED in production — generate e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-dev-secret

# App bind (used by app.py / gunicorn)
HOST=127.0.0.1
PORT=5000

# Flask dev server (app.py only)
# GC_FLASK_RELOADER=0   # single process — fewer SQLite lock issues on Windows
# GC_FLASK_THREADED=1

# ---------------------------------------------------------------------------
# Database (SQLite default — Postgres driver exists; production cutover gated)
# ---------------------------------------------------------------------------
GC_DB_BACKEND=sqlite

# Preferred: explicit SQLite file path (relative to project root or absolute)
# Local dev:
GC_DB_PATH=game/game.db
# Railway / Docker with volume at /data:
# GC_DB_PATH=/data/game.db

# Postgres: set GC_DB_BACKEND=postgres + DATABASE_URL=postgresql://…
# Production additionally requires GC_ALLOW_POSTGRES_PROD=1 (intentional cutover only).
# Do NOT point DATABASE_URL at Postgres on Railway while GC_DB_BACKEND=sqlite.
# Alternative for local SQLite only:
# DATABASE_URL=sqlite:///game/game.db
# GC_ALLOW_POSTGRES_PROD=0


# Legacy alias (mapped to GC_DB_PATH if GC_DB_PATH unset)
# DATABASE_PATH=game/game.db

# ---------------------------------------------------------------------------
# Optional services (not required for local alpha)
# ---------------------------------------------------------------------------

# Redis — session/cache (future)
# REDIS_URL=redis://127.0.0.1:6379/0

# Mail — account verification & password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1
MAIL_FROM=noreply@example.com

# Public URL for links in emails (verify / reset)
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Discord OAuth (GC-733A login/register)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:5000/auth/discord/callback
DISCORD_INVITE_URL=https://discord.gg/CYP8qWE7VM

# Support tickets → Discord (GC-656B) — never commit tokens/IDs
# Variant 1 (recommended): forum #tickets — Bot with Create Public Threads + Send Messages
# DISCORD_BOT_TOKEN=
# DISCORD_SUPPORT_FORUM_CHANNEL_ID=
# Forum tag snowflakes (Developer Mode → right-click tag → Copy ID):
# DISCORD_SUPPORT_TAG_CHEATER=
# DISCORD_SUPPORT_TAG_PAYMENTS=
# DISCORD_SUPPORT_TAG_ANYTHING=
# DISCORD_SUPPORT_TAG_IN_PROGRESS=
# DISCORD_SUPPORT_TAG_DONE=
# Variant 2 (optional): separate text channel #ticket-feed via webhook
# DISCORD_SUPPORT_WEBHOOK_URL=
# Optional override if Cloudflare blocks default server User-Agent:
# DISCORD_USER_AGENT=Genesis-Colonies/1.0 (+https://www.genesis-colonies.de)

# Future: allow login with email instead of username (backend ready, UI unchanged)
# GC_LOGIN_ALLOW_EMAIL=0

# Legacy aliases (optional)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@example.com

# ---------------------------------------------------------------------------
# Production / Railway (optional tuning)
# ---------------------------------------------------------------------------
# Operator checklist: docs/RAILWAY_OPERATOR.md
# APP_ENV=production
# FLASK_ENV=production
# FLASK_DEBUG=0
# GC_DB_PATH=/data/game.db
# GUNICORN_WORKERS=1
# PUBLIC_BASE_URL=https://www.genesis-colonies.de
# In-process ranking/fleet/vote + daily SQLite backups (default on in production):
# GC_EMBEDDED_CRON=1
# GC_EMBEDDED_CRON_SEC=60
# GC_EMBEDDED_BACKUP=1
# GC_EMBEDDED_BACKUP_KEEP=7
# GC_POLL_ACTIVE_MS=5000
# GC_POLL_IDLE_MS=12000
# GC_POLL_HIDDEN_MS=30000
# Diet poll delta short-circuit (default on). Set 0 to disable ?since= unchanged responses.
# GC_STATE_DELTA=1
# GC_SHIPYARD_POLL_MS=8000


# ---------------------------------------------------------------------------
# EPIC-23 Payment / Shop — PayPal default (Stripe optional)
# ---------------------------------------------------------------------------
# 1) Create REST app at https://developer.paypal.com/dashboard/applications
#    (Sandbox first). Do NOT use classic HTML "PayPal-Buttons" seller tools.
# 2) Webhooks → https://www.genesis-colonies.de/api/webhooks/paypal
#    Events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED
# 3) Set keys below, then SHOP_ENABLED=1
#
# SHOP_ENABLED=0
# SHOP_TEST_PROVIDER=0
# SHOP_ENABLE_STRIPE=0
# SHOP_SUCCESS_URL=
# SHOP_CANCEL_URL=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_MODE=live
# Live: create app under Apps & Credentials → LIVE tab (not Sandbox).
# Sandbox mode only allows fake sandbox buyer accounts — real login needs LIVE keys.
#
# Optional Stripe (only if SHOP_ENABLE_STRIPE=1):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=
#
# Doc: docs/PAYMENT_SHOP.md

# ---------------------------------------------------------------------------
# Story Ops TTS (edge-tts — Killian default DE)
# ---------------------------------------------------------------------------
# STORY_TTS_VOICE=de-DE-KillianNeural
# STORY_TTS_RATE=-3%
# STORY_TTS_PITCH=-1Hz
# STORY_TTS_VOLUME=+0%

# ---------------------------------------------------------------------------
# Vote providers
# ---------------------------------------------------------------------------
# GTop100 pingback key (must match GTop100 dashboard pingback key)
GTOP100_PINGBACK_KEY=

# Arena-Top100 callback secret (must match Arena dashboard callback secret)
ARENA_TOP100_SECRET=

# GameToor Instant Vote Notification key (must match GameToor dashboard "With Key")
GAMETOOR_IVN_KEY=

# ---------------------------------------------------------------------------
# Internal HTTP cron (optional manual/force — embedded cron covers production)
# ---------------------------------------------------------------------------
# Bearer token for POST /api/internal/cron/ranking (optional when GC_EMBEDDED_CRON=1).
# GC_INTERNAL_CRON_TOKEN=
# Cap pirate AI bots processed per fleet-cron tick (default 3). Prevents SQLite hang after idle.
# GC_PIRATE_PLAY_BOTS_PER_TICK=3
# Soft wall-clock budget for post-fleet maintenance bag (seconds, default 25).
# GC_POST_FLEET_MAINTENANCE_BUDGET_SEC=25
#
# Inactive autoplay (EPIC-26) — living dormant humans; Doc: docs/INACTIVE_AUTOPLAY.md
# GC_INACTIVE_AUTOPLAY_ENABLED=1
# GC_INACTIVE_AUTOPLAY_BATCH=3
# GC_INACTIVE_AUTOPLAY_INTERVAL_SEC=600
# GC_INACTIVE_AUTOPLAY_REVISIT_SEC=129600
# GC_INACTIVE_AUTOPLAY_MAX_SESSIONS=40
# GC_INACTIVE_AUTOPLAY_TICK_PER_CRON=8

# ---------------------------------------------------------------------------
# Bootstrap overrides (install / CI only)
# ---------------------------------------------------------------------------
# GC_SKIP_MIGRATION_CHECK=1
# GC_SKIP_BOOTSTRAP=0
