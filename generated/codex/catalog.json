  "commander_tips_pool": [
    {
      "codex_id": "alliance",
      "text": "Spenden vom Planeten mit Überschuss — Context-Planet prüfen."
    },
    {
      "codex_id": "alliance",
      "text": "Officer: Pool für das nächste Projekt füllen, bevor ihr startet."
    },
    {
      "codex_id": "alliance",
      "text": "NAP mit Nachbarn früh klären, bevor Flottenmissverständnisse entstehen."
    },
    {
      "codex_id": "asteroids",
      "text": "Dichte Systeme beobachten — dort spawnen Gürtel zuerst."
    },
    {
      "codex_id": "asteroids",
      "text": "Fracht und Ernter-Anzahl vor dem Send checken; First-Arrival zählt."
    },
    {
      "codex_id": "asteroids",
      "text": "Nicht mit Debris-Recycle verwechseln: Asteroid-Flüge fallen nicht auf Debris zurück."
    },
    {
      "codex_id": "auction",
      "text": "Vor dem Bieten auf einen Planeten mit genug Ressourcen wechseln."
    },
    {
      "codex_id": "auction",
      "text": "Restzeit beobachten — Last-Second-Raises sind üblich."
    },
    {
      "codex_id": "auction",
      "text": "Gewonnene Boxen landen im Inventar — dort öffnen, nicht auf der Auktionsseite."
    },
    {
      "codex_id": "buildings",
      "text": "Energie im Plus halten, bevor du Minen massiv hochziehst."
    },
    {
      "codex_id": "buildings",
      "text": "Speicher früh ausbauen — volles Lager stoppt Produktion."
    },
    {
      "codex_id": "buildings",
      "text": "Kurze Bauzeiten als Lückenfüller vor Offline-Phasen; lange Jobs für Abwesenheit."
    },
    {
      "codex_id": "buildings",
      "text": "Queue-Limit beachten — plan die gesamte Queue, nicht nur den ersten Slot."
    },
    {
      "codex_id": "case_battles",
      "text": "Nur Container einsetzen, deren Verlust du verkraftest — Escrow ist echt weg bis Cancel/Finish."
    },
    {
      "codex_id": "case_battles",
      "text": "Modus lesen, bevor du joinest (Share ≠ Winner-takes-all)."
    },
    {
      "codex_id": "case_battles",
      "text": "Private Lobby mit Freunden, wenn du Randoms meiden willst."
    },
    {
      "codex_id": "collector_exchange",
      "text": "Lifetime-Ziele im Blick behalten, bevor du alles für Sofort-Booster verbrennst."
    },
    {
      "codex_id": "collector_exchange",
      "text": "Schrottmeister für Werft-nahe Boosts; Xenobiologe für Research/PE."
    },
    {
      "codex_id": "collector_exchange",
      "text": "Redeem nur mit genug Input — Teilmengen helfen nicht."
    },
    {
      "codex_id": "combat",
      "text": "Kampf-Techs vor dem ersten Angriff — sie wirken auf die gesamte Flotte bzw. Verteidigung."
    },
    {
      "codex_id": "combat",
      "text": "Verteidigung am Planeten zählt mit — nicht nur Schiffe im Hangar."
    },
    {
      "codex_id": "combat",
      "text": "Plunder ist begrenzt durch Rückkehr-Cargo, nicht durch unendlichen Raub."
    },
    {
      "codex_id": "commander_classes",
      "text": "Klasse an deinen Hauptloop wählen — Eco vs. Fleet vs. PvP — nicht „alles ein bisschen“."
    },
    {
      "codex_id": "commander_classes",
      "text": "SP erst claimen, dann Trunk pushen; Capstones nur mit vollen Depots am Kontext-Planeten."
    },
    {
      "codex_id": "commander_classes",
      "text": "Swap sparsam: Timekeeper ist knapp und der Baum startet neu."
    },
    {
      "codex_id": "defense",
      "text": "Outposts und Mining-Kolonien nicht ohne Defense im PvP-Raum lassen."
    },
    {
      "codex_id": "defense",
      "text": "`shield_tech` und `weapon_tech` stärken auch Verteidigung in Combat."
    },
    {
      "codex_id": "defense",
      "text": "Defense-Queue parallel zur Werft auf derselben Welt planen."
    },
    {
      "codex_id": "resources",
      "text": "Erst Energie stabilisieren, dann Output pushen."
    },
    {
      "codex_id": "resources",
      "text": "Speicher vor großen Offline-Phasen prüfen."
    },
    {
      "codex_id": "resources",
      "text": "Brennzellen ohne Depot produzieren nicht angesammelt — Depot planen."
    },
    {
      "codex_id": "trader",
      "text": "Hub nutzen, wenn ein Rohstoff staut und ein anderer fehlt — nicht nur Minen stapeln."
    },
    {
      "codex_id": "trader",
      "text": "Tageslimit im Kopf behalten; große Umbauten vorher mit Lager planen."
    },
    {
      "codex_id": "expansion",
      "text": "„Neue Welt“ ≠ sofort Kolonie — Outpost-Etablierung aktiv spielen."
    },
    {
      "codex_id": "expansion",
      "text": "Checkliste auf Outpost und Command Map beachten."
    },
    {
      "codex_id": "expansion",
      "text": "Expansion Sites erscheinen mit Ark-Entwicklungsstufe — Evolution vor Slot-Denken."
    },
    {
      "codex_id": "faq_general",
      "text": "Auf Overview starten und Ark-Produktion stabilisieren, bevor expandiert wird."
    },
    {
      "codex_id": "faq_general",
      "text": "Vor Ressourcen-Ausgaben den Header-Planeten-Switcher prüfen."
    },
    {
      "codex_id": "faq_general",
      "text": "Gesperrte Codex-Einträge zeigen einen Teaser — zugehörige Seite besuchen oder Ark entwickeln."
    },
    {
      "codex_id": "fleet",
      "text": "Flotten-Abgang immer mit aktivem Planet abstimmen — Schiffe liegen planetengebunden."
    },
    {
      "codex_id": "fleet",
      "text": "Navigation-Tech für mehr parallele Flotten priorisieren."
    },
    {
      "codex_id": "fleet",
      "text": "Expedition: Expo-Hüllen für Funde; Frachter für Bergungskapazität — Rollen beachten."
    },
    {
      "codex_id": "diplomacy",
      "text": "Vor großen Investitionsentscheidungen Bloc und Trait der Galaxie checken."
    },
    {
      "codex_id": "diplomacy",
      "text": "Imperial Directives ≠ Galactic Diplomacy — persönlich vs. Galaxie-Politik."
    },
    {
      "codex_id": "diplomacy",
      "text": "Bloc-Wechsel hat Cooldown; während offener Resolution oft gesperrt."
    },
    {
      "codex_id": "galactic_directives",
      "text": "Stimme in jeder Galaxie, in der du ernsthaft produzierst — eine Ignoranz kostet Mandate."
    },
    {
      "codex_id": "galactic_directives",
      "text": "Tradeoffs lesen: starke Primary-Boni kommen selten ohne Malus."
    },
    {
      "codex_id": "galactic_directives",
      "text": "Policies lokal an das galaktische Mandat anpassen (Industrie vs. Research)."
    },
    {
      "codex_id": "galaxy",
      "text": "Expansion planen auf der **Weltkarte**, nicht nur in der Slot-Liste."
    },
    {
      "codex_id": "galaxy",
      "text": "Aktiver Planet markiert den Slot in der Systemansicht."
    },
    {
      "codex_id": "galaxy",
      "text": "Expeditions-Slot ist kein normaler Kolonie-Planet."
    },
    {
      "codex_id": "command_map",
      "text": "Expansion und Orte zuerst auf der **Weltkarte** planen, nicht nur in der Slot-Liste."
    },
    {
      "codex_id": "command_map",
      "text": "Genesis Ark bleibt der Hub — Kolonien drumherum lesen."
    },
    {
      "codex_id": "command_map",
      "text": "`/empire` = Produktion/Matrix; Weltkarte = `/galaxy` Weltkarte-Tab."
    },
    {
      "codex_id": "influence",
      "text": "Einfluss als Fußabdruck lesen, während du Expansion planst."
    },
    {
      "codex_id": "influence",
      "text": "Lücken zwischen Kolonien sind normal, bis du mehr Welten gründest."
    },
    {
      "codex_id": "influence",
      "text": "Erwarte keine PvP-Buffs vom teal Glow — das ist Territoriums-Visualisierung."
    },
    {
      "codex_id": "strategic_worlds",
      "text": "Inspector lesen, bevor du Flotte bindest — Typ entscheidet Kolonie vs. Expedition."
    },
    {
      "codex_id": "strategic_worlds",
      "text": "Spezialisierung auf eigenen Welten ist dauerhaft; vor der Wahl nachdenken."
    },
    {
      "codex_id": "strategic_worlds",
      "text": "Strategic World ≠ Ersatz-Hauptstadt — die Genesis Ark bleibt Zentrum."
    },
    {
      "codex_id": "expeditions",
      "text": "Expo-Schiffe für Funde mitnehmen; Frachter für Bergung; Eskorten gegen Piraten."
    },
    {
      "codex_id": "expeditions",
      "text": "World-Expeditionen über Inspector starten — Ziel bleibt an den Ort gebunden."
    },
    {
      "codex_id": "expeditions",
      "text": "Berichte immer im Posteingang lesen; Preview nur vom Server vertrauen."
    },
    {
      "codex_id": "salvage",
      "text": "Salvage-Schiffe vor dem Start prüfen — Preview spart Fehlflüge."
    },
    {
      "codex_id": "salvage",
      "text": "Wrackfeld ≠ Asteroid ≠ Debris: Mission und Zieltyp in der UI lesen."
    },
    {
      "codex_id": "salvage",
      "text": "Berichte im Posteingang behalten Kontext für Folgeflüge."
    },
    {
      "codex_id": "logistics",
      "text": "Vor Collect: Frachter auf den **Quellen** stationieren; vor Distribute: Frachter am **Hub**."
    },
    {
      "codex_id": "logistics",
      "text": "Hub = aktiver Planet prüfen, bevor du startest."
    },
    {
      "codex_id": "logistics",
      "text": "Freie Flotten-Slots checken — viele Ziele brauchen viele Slots."
    },
    {
      "codex_id": "story_ops",
      "text": "Story und Imperial Directives parallel lesen — unterschiedliche Rhythmen, gemeinsames Gameplay."
    },
    {
      "codex_id": "story_ops",
      "text": "Choices ernst nehmen: Flags können spätere Beats und Codex-Fragmente öffnen."
    },
    {
      "codex_id": "story_ops",
      "text": "Ark-Token nicht mit EUR-Shop verwechseln — Free Shop ist der Story-Tab."
    },
    {
      "codex_id": "imperial_directives",
      "text": "Claim nicht vergessen — abgeschlossen ≠ automatisch eingesammelt."
    },
    {
      "codex_id": "imperial_directives",
      "text": "Daily/Weekly ergänzen normales Bauen und Fliegen; nichts erzwingen."
    },
    {
      "codex_id": "imperial_directives",
      "text": "Nav-Badge zeigt claimbare Direktiven."
    },
    {
      "codex_id": "genesis_ark",
      "text": "Denke in Imperium, nicht in „Mine 17 → 18“ — die Ark-Entwicklungsstufe öffnet neue Möglichkeiten."
    },
    {
      "codex_id": "genesis_ark",
      "text": "Account-Forschung und Imperiums-Entscheidungen gehören zur Ark; Planet-Tech gehört zu einzelnen Welten."
    },
    {
      "codex_id": "genesis_ark",
      "text": "Die Command Map visualisiert dein wachsendes Reich — die Ark bleibt der Hub."
    },
    {
      "codex_id": "inventory",
      "text": "Timekeeper für lange Offline-Jobs sparen; kurze Filler ohne TK durchlaufen lassen."
    },
    {
      "codex_id": "inventory",
      "text": "Container öffnen, wenn du Boosters sofort brauchst — sonst Inventar voller „später“."
    },
