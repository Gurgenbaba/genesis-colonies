# Genesis Colonies — Beispiel-Umgebungsvariablen
# Kopieren:  copy .env.example .env   (Windows)
# Die App liest derzeit primär SECRET_KEY aus der Umgebung (siehe app.py).
# DATABASE_PATH ist dokumentiert für spätere Erweiterung — wird noch nicht von app.py gelesen.

FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-dev-secret
DATABASE_PATH=game/game.db
